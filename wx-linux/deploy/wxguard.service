[Unit]
Description=WeChat + Xvfb 24x7 supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 将 /opt/wechat-bot/wx-linux 替换为你的项目实际路径
ExecStart=/opt/wechat-bot/wx-linux/venv/bin/python -u /opt/wechat-bot/wx-linux/wxguard.py
Restart=always
RestartSec=5
KillMode=process

[Install]
WantedBy=multi-user.target
